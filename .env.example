# ==============================================================================
# BanaSetu Environment Configuration Template
# Minor Forest Produce (MFP) Traceability Ledger for Odisha (TDCCOL / LABHA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Central PostgreSQL Database Connection (Prisma)
# ------------------------------------------------------------------------------
# Managed Supabase PostgreSQL / Standard PostgreSQL 15+ URI.
# For Supabase with Transaction Pooling (Serverless / Next.js):
# DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# When unconfigured or unreachable, the application safely operates in offline Dexie mode with HTTP 503 fallback.
DATABASE_URL="postgresql://postgres.your-project-ref:replace_with_secure_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ------------------------------------------------------------------------------
# 2. Managed Durable Evidence Storage (Supabase Storage - Phase C)
# ------------------------------------------------------------------------------
# Private bucket for collection photo evidence, electronic scale readouts, and voice notes.
# Kept strictly server-side. Access via short-lived signed URLs.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_with_server_side_service_role_key"
SUPABASE_STORAGE_BUCKET="banasetu-evidence"

# ------------------------------------------------------------------------------
# 3. Server Authentication & Session Security (F2 / F3)
# ------------------------------------------------------------------------------
# 256-bit cryptographically secure secret used to sign and verify HMAC-SHA256 JWT cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_32_character_random_hex_or_base64_secret"

# ------------------------------------------------------------------------------
# 4. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Explicit opt-in for 1-Click Evaluator Personas (SAFE_TEST_ACCOUNTS) during evaluation/development
# when central DATABASE_URL is not configured.
# STRICT INVARIANT: Ignored and permanently rejected when NODE_ENV="production".
ALLOW_DEMO_ACCOUNTS="true"

# ------------------------------------------------------------------------------
# 5. External Government & Banking Gateway Stubs (Phase F14 - Safe Boundaries)
# ------------------------------------------------------------------------------
# These represent authorized external state systems. Do NOT put production credentials here.
GOV_DBT_GATEWAY_URL="https://pfms.nic.in/api/v1/mock-dbt"
NIC_SMS_GATEWAY_URL="https://smsgw.nic.in/api/v2/mock-sms"
